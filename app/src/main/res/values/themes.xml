<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VidownPhone" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.VidownPhone.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.VidownPhone.MaterialAlertDialog</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Opaque overlays: dialogs and bottom sheets must never show content through them -->
    <style name="ThemeOverlay.VidownPhone.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurface">@color/surface_opaque</item>
        <item name="colorSurfaceContainerLow">@color/surface_opaque</item>
        <item name="colorSurfaceContainer">@color/surface_opaque</item>
        <item name="colorSurfaceContainerHigh">@color/surface_opaque_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_opaque_highest</item>
        <item name="android:colorBackground">@color/surface_opaque</item>
    </style>

    <style name="ThemeOverlay.VidownPhone.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_opaque_high</item>
        <item name="colorSurfaceContainer">@color/surface_opaque_high</item>
        <item name="colorSurfaceContainerHigh">@color/surface_opaque_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_opaque_highest</item>
        <item name="android:colorBackground">@color/surface_opaque_high</item>
    </style>

    <style name="Theme.VidownPhone.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="Theme.VidownPhone.ShareSheet" parent="Theme.VidownPhone">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Koyu Karbon & Kızıl Açılış Ekranı (Splash Theme) -->
    <style name="Theme.VidownPhone.Splash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash_screen</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- Android 12+ (API 31+) SplashScreen API -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/background_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@android:color/transparent</item>
    </style>
</resources>
